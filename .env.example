# ============================================================================
# DATAPULSE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env for local execution. Never commit real secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. WAREHOUSE SOURCE ENGINE SELECTION
# Options: duckdb_local | snowflake
# ----------------------------------------------------------------------------
SOURCE_ENGINE=duckdb_local
DUCKDB_DATABASE_PATH=data/local_warehouse.duckdb

# ----------------------------------------------------------------------------
# 2. SNOWFLAKE PRODUCTION & FINOPS SETTINGS (Used when SOURCE_ENGINE=snowflake)
# Authenticated via Asymmetric 2048-bit RSA Key-Pair (Zero Passwords)
# ----------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=xy12345.eu-central-1
SNOWFLAKE_USER=SVC_DATA_PULSE
SNOWFLAKE_ROLE=ROLE_DATA_PULSE_SERVICE
SNOWFLAKE_WAREHOUSE=WH_DATA_PULSE_XS
SNOWFLAKE_DATABASE=ANALYTICS_PROD
SNOWFLAKE_SCHEMA=MARTS
SNOWFLAKE_AUDIT_SCHEMA=AUDIT
SNOWFLAKE_PRIVATE_KEY_PATH=infra/keys/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_CREDIT_PRICE_USD=3.00

# ----------------------------------------------------------------------------
# 3. DESTINATION & TYPESCRIPT CONNECTOR SETTINGS
# ----------------------------------------------------------------------------
HUBSPOT_API_BASE_URL=http://localhost:3000
HUBSPOT_API_KEY=your_hubspot_private_app_token_here
WEBHOOK_HMAC_SECRET=replace-with-256-bit-hmac-signing-secret
SYNC_BATCH_SIZE=100
MAX_RETRY_ATTEMPTS=3

# ----------------------------------------------------------------------------
# 4. OBSERVABILITY & MULTI-CHANNEL ALERTING
# Options: console | discord | slack
# ----------------------------------------------------------------------------
ALERT_PROVIDER=console
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/replace-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/replace-token

# ----------------------------------------------------------------------------
# 5. OPTIONAL OUT-OF-BAND AI DIAGNOSTICS (DLQ Post-Mortem Triage Only)
# Note: Never invoked inside hot Reverse ETL ingestion loops.
# Options: heuristic_local | gemini | openai
# ----------------------------------------------------------------------------
AI_PROVIDER=heuristic_local
GEMINI_API_KEY=
OPENAI_API_KEY=

