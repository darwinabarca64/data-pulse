# ============================================================================
# DataPulse Core Reverse ETL Engine Container (infra/docker/Dockerfile.engine)
# ============================================================================
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8

WORKDIR /app

COPY pyproject.toml LICENSE ./
COPY docs/runbooks/00-host-hardware-and-wsl2-setup.md ./docs/runbooks/00-host-hardware-and-wsl2-setup.md
COPY core-engine/ ./core-engine/
COPY syncs/ ./syncs/

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e . && \
    mkdir -p /app/data

ENTRYPOINT ["datapulse"]
CMD ["run", "--manifest", "syncs/hubspot_profitability.yml"]

